<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SteamSync.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="SteamSync.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SteamSync"
        Width="900" Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="200, *">
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#2d2d30" Padding="10">
            <StackPanel Spacing="10">
                <TextBlock Text="SteamSync" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,10,0,20" HorizontalAlignment="Center"/>
                
                <Button Command="{Binding NavigateToGamesCommand}" 
                        Content="Games Library" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        Foreground="White"
                        Padding="15,10"
                        FontSize="16"/>
                        
                <Button Command="{Binding NavigateToSettingsCommand}" 
                        Content="Settings" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        Foreground="White"
                        Padding="15,10"
                        FontSize="16"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Padding="20">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>
    </Grid>

</Window>
