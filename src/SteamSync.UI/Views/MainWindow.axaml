<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SteamSync.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="SteamSync.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SteamSync"
        Width="1120" Height="720"
        MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#18181b">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="220, *">
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#1f1f24" BorderThickness="0,0,1,0" BorderBrush="#2e2e38" Padding="14,18">
            <Grid RowDefinitions="Auto, *, Auto">
                <!-- App Header -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,6,0,24" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="22" VerticalAlignment="Center"/>
                        <TextBlock Text="SteamSync" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Non-Steam Game Importer" FontSize="11" Foreground="#888894" HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- Navigation Links -->
                <StackPanel Grid.Row="1" Spacing="8">
                    <Button Command="{Binding NavigateToGamesCommand}" 
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Left"
                            Background="#2a2a34"
                            Foreground="White"
                            CornerRadius="6"
                            Padding="14,10"
                            FontSize="14"
                            FontWeight="Medium">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🎮" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Games Library" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                        
                    <Button Command="{Binding NavigateToSettingsCommand}" 
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="#b0b0be"
                            CornerRadius="6"
                            Padding="14,10"
                            FontSize="14"
                            FontWeight="Medium">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="⚙️" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Sidebar Footer -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="SteamSync v1.0" FontSize="11" Foreground="#555562"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Padding="20,16" Background="#18181b">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>
    </Grid>

</Window>
