<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SteamSync.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
             x:Class="SteamSync.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Spacing="16" Margin="0,0,10,16">
      
      <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>

      <!-- API Keys -->
      <Border Background="#1f1f24" Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#2e2e38">
        <StackPanel Spacing="10">
          <TextBlock Text="API Integration" FontWeight="SemiBold" FontSize="15" Foreground="White"/>
          <TextBlock Text="SteamGridDB API Key (Required for artwork):" Foreground="#9e9ea8" FontSize="13"/>
          <TextBox Text="{Binding SteamGridDbApiKey}" PasswordChar="*" PlaceholderText="Paste Bearer token here..." CornerRadius="6"/>
        </StackPanel>
      </Border>

      <!-- Launchers -->
      <Border Background="#1f1f24" Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#2e2e38">
        <StackPanel Spacing="10">
          <TextBlock Text="Auto-Detection Platforms" FontWeight="SemiBold" FontSize="15" Foreground="White"/>
          <CheckBox IsChecked="{Binding DetectEpic}" Content="Epic Games Store"/>
          <CheckBox IsChecked="{Binding DetectGog}" Content="GOG Galaxy"/>
          <CheckBox IsChecked="{Binding DetectUbisoft}" Content="Ubisoft Connect"/>
          <CheckBox IsChecked="{Binding DetectEa}" Content="EA App"/>
          <CheckBox IsChecked="{Binding DetectBattleNet}" Content="Battle.net"/>
          <CheckBox IsChecked="{Binding DetectRockstar}" Content="Rockstar Games"/>
        </StackPanel>
      </Border>

      <!-- Custom Directories -->
      <Border Background="#1f1f24" Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#2e2e38">
        <StackPanel Spacing="10">
          <TextBlock Text="Custom Scan Directories (DRM-Free / Standalone)" FontWeight="SemiBold" FontSize="15" Foreground="White"/>
          <TextBlock Text="Add folders containing standalone or DRM-free games to scan." Foreground="#9e9ea8" FontSize="13"/>
          
          <ListBox ItemsSource="{Binding CustomScanDirectories}" Height="130" Background="#141418" CornerRadius="6">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*, Auto" Margin="4,2">
                  <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#e0e0ea"/>
                  <Button Grid.Column="1" Content="Remove" 
                          Background="#3a2020" Foreground="#ff8080" CornerRadius="4" Padding="10,4"
                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveDirectoryCommand}"
                          CommandParameter="{Binding}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid ColumnDefinitions="*, Auto, Auto">
            <TextBox Grid.Column="0" 
                     Text="{Binding NewDirectoryPath}"
                     PlaceholderText="Enter path or click Browse..." 
                     Margin="0,0,8,0" CornerRadius="6"/>
            <Button Grid.Column="1" Content="Browse..." 
                    Background="#2d2d36" Foreground="White" CornerRadius="6" Padding="14,8" Margin="0,0,8,0"
                    Command="{Binding BrowseDirectoryCommand}"/>
            <Button Grid.Column="2" Content="Add Directory" 
                    Background="#3b82f6" Foreground="White" CornerRadius="6" Padding="14,8"
                    Command="{Binding AddDirectoryCommand}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Save -->
      <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
        <Button Command="{Binding SaveSettingsCommand}" Content="Save Settings" Classes="accent" Padding="20,10" CornerRadius="6" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#4ade80" FontWeight="Medium"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
