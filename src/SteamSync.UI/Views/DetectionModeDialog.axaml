<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SteamSync.UI.Views.DetectionModeDialog"
        Title="Choose Detection Method"
        Width="520" Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1e1e1e"
        ExtendClientAreaToDecorationsHint="False">

  <Grid RowDefinitions="Auto, *, Auto" Margin="24">

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="Choose Detection Method" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
      <TextBlock Text="How should SteamSync discover your games?" FontSize="13" Foreground="#999999" HorizontalAlignment="Center" Margin="0,6,0,0"/>
    </StackPanel>

    <!-- Two big option buttons -->
    <Grid Grid.Row="1" ColumnDefinitions="*, 16, *">

      <!-- Local Offline -->
      <Button Grid.Column="0" x:Name="LocalButton" Click="OnLocalClicked"
              Background="#2d2d30" BorderBrush="#569cd6" BorderThickness="2"
              CornerRadius="8" Padding="16" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand">
        <StackPanel Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="🔌" FontSize="32" HorizontalAlignment="Center"/>
          <TextBlock Text="Local Offline" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
          <TextBlock Text="Fast, no login required." FontSize="12" Foreground="#aaaaaa" HorizontalAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="Reads local registries, databases, and install folders." FontSize="11" Foreground="#777777" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
      </Button>

      <!-- Cloud / Playnite -->
      <Button Grid.Column="2" x:Name="CloudButton" Click="OnCloudClicked"
              Background="#2d2d30" BorderBrush="#6a9955" BorderThickness="2"
              CornerRadius="8" Padding="16" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand">
        <StackPanel Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="☁️" FontSize="32" HorizontalAlignment="Center"/>
          <TextBlock Text="Cloud / Web" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
          <TextBlock Text="Comprehensive. Browser login required." FontSize="12" Foreground="#aaaaaa" HorizontalAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="Uses Playnite engine to scrape platform APIs." FontSize="11" Foreground="#777777" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
      </Button>

    </Grid>

    <!-- Cancel -->
    <Button Grid.Row="2" x:Name="CancelButton" Click="OnCancelClicked"
            Content="Cancel" HorizontalAlignment="Center" Margin="0,20,0,0"
            Padding="24,8" Background="#333337" Foreground="#cccccc" CornerRadius="4"/>

  </Grid>
</Window>
